# Digi-Key API Configuration
DIGIKEY_CLIENT_ID=your_digikey_client_id_here
DIGIKEY_CLIENT_SECRET=your_digikey_client_secret_here
DIGIKEY_API_KEY=your_digikey_api_key_here
DIGIKEY_SCOPE=

# Mouser API Configuration
MOUSER_API_KEY=your_mouser_api_key_here

# Groq API Configuration (for AI features)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Nexar API Configuration (optional)
NEXAR_CLIENT_ID=your_nexar_client_id_here
NEXAR_CLIENT_SECRET=your_nexar_client_secret_here

# Database Settings
DB_PATH=./components.db

# API Rate Limiting
MOUSER_DAILY_LIMIT=20000
DIGIKEY_DAILY_LIMIT=50000
MOUSER_MIN_INTERVAL_SEC=0.30
DIGIKEY_MIN_INTERVAL_SEC=0.10

# Max parallel workers for API calls
MAX_PARALLEL_WORKERS=48

# Datasheet AI Settings
DATASHEET_AI_MAX_OUTPUT_TOKENS=2200
DATASHEET_AI_MAX_REQUEST_CHARS=22000
DATASHEET_ANALYZER_MAX_BYTES=12000000
DATASHEET_ANALYZER_MAX_TEXT_CHARS=12000
DATASHEET_ANALYZER_MAX_TEXT_CHARS_PER_FILE=6000

# Ollama Settings (for local AI)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Queue Settings
SQLITE_QUEUE_SERIAL_MODE=0
QUEUE_STALE_RECOVERY_SECONDS=1800
